{
  "name": "paperclip-plugin-discord",
  "version": "0.11.0",
  "type": "module",
  "main": "./dist/index.js",
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run",
    "version": "node scripts/sync-plugin-version.mjs && git add src/constants.ts",
    "prepublishOnly": "npm run build",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "@paperclipai/plugin-sdk": "*",
    "@paperclipai/shared": "*",
    "@discordjs/voice": "^0.18.0 || ^0.19.0",
    "prism-media": "^1.3.5",
    "opusscript": "^0.0.8",
    "libsodium-wrappers": "^0.7.13 || ^0.8.0",
    "ws": "^8.18.0"
  },
  "peerDependenciesMeta": {
    "@discordjs/voice": {
      "optional": true
    },
    "prism-media": {
      "optional": true
    },
    "opusscript": {
      "optional": true
    },
    "libsodium-wrappers": {
      "optional": true
    },
    "ws": {
      "optional": true
    }
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "@paperclipai/plugin-sdk": "^2026.817.0",
    "@paperclipai/shared": "^2026.817.0",
    "@types/ws": "^8.18.1",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5",
    "typescript": "^5.7.0",
    "vitest": "^5.0.0",
    "ws": "^8.21.3"
  },
  "files": [
    "dist/"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvanhorn/paperclip-plugin-discord.git"
  },
  "license": "MIT"
}
